---
interface FacetOption {
  name: string;
  count: number;
}

interface Props {
  crimes: FacetOption[];
  positions: FacetOption[];
  tags: FacetOption[];
  variant?: 'desktop' | 'mobile';
}

const { crimes, positions, tags, variant = 'desktop' } = Astro.props;
const idPrefix = variant === 'mobile' ? 'm-' : '';
---

<aside
  id={`${idPrefix}filter-sidebar`}
  class:list={[
    'filter-sidebar bg-stone-100 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700/50 rounded-xl p-5',
    variant === 'desktop' ? 'sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto' : '',
  ]}
  aria-labelledby={`${idPrefix}filter-heading`}
>
  <div class="flex items-center justify-between mb-4">
    <h2 id={`${idPrefix}filter-heading`} class="text-lg font-bold text-stone-800 dark:text-stone-100 font-display">Filters</h2>
    <button
      id={`${idPrefix === '' ? 'clear-filters' : idPrefix + 'clear-filters'}`}
      class="text-xs text-stone-500 dark:text-stone-400 hover:text-copper focus:outline-none focus:ring-2 focus:ring-copper focus:ring-offset-2 focus:ring-offset-stone-100 dark:focus:ring-offset-stone-800 rounded px-1 transition-colors"
      type="button"
    >
      Clear all
    </button>
  </div>

  <fieldset class="mb-6">
    <legend class="w-full">
      <button
        class="filter-section-toggle flex items-center justify-between w-full text-left mb-3"
        data-section={`${idPrefix}crimes`}
        aria-expanded="true"
        aria-controls={`${idPrefix}crimes-section`}
        type="button"
      >
        <span class="text-sm font-semibold text-stone-700 dark:text-stone-200 uppercase tracking-wide">Crime Type</span>
        <svg class="w-4 h-4 text-stone-400 dark:text-stone-500 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </legend>
    <div class="mb-3">
      <label class="sr-only" for={`${idPrefix}crimes-search`}>Search crime filters</label>
      <input
        id={`${idPrefix}crimes-search`}
        type="search"
        data-filter-search={`${idPrefix}crimes-section`}
        placeholder="Search crime filters"
        class="w-full rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm text-stone-800 dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-copper"
      />
    </div>
    <div id={`${idPrefix}crimes-section`} class="space-y-1.5 max-h-64 overflow-y-auto scrollbar-thin">
      {crimes.map((crime) => (
        <label class="flex items-center gap-2 cursor-pointer group py-1 min-h-[32px]" data-filter-option data-filter-label={crime.name.toLowerCase()}>
          <input
            type="checkbox"
            name="crime"
            value={crime.name}
            class="filter-checkbox w-4 h-4 rounded border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-700 text-copper focus:ring-2 focus:ring-copper focus:ring-offset-stone-100 dark:focus:ring-offset-stone-800"
          />
          <span class="text-sm text-stone-700 dark:text-stone-300 group-hover:text-copper transition-colors truncate">
            {crime.name}
          </span>
          <span class="ml-auto text-xs text-stone-500 dark:text-stone-400 tabular-nums">
            {crime.count}
          </span>
        </label>
      ))}
      <p class="hidden text-sm text-stone-500 dark:text-stone-400 py-2" data-filter-empty>
        No matching crime filters.
      </p>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="w-full">
      <button
        class="filter-section-toggle flex items-center justify-between w-full text-left mb-3"
        data-section={`${idPrefix}positions`}
        aria-expanded="true"
        aria-controls={`${idPrefix}positions-section`}
        type="button"
      >
        <span class="text-sm font-semibold text-stone-700 dark:text-stone-200 uppercase tracking-wide">Position</span>
        <svg class="w-4 h-4 text-stone-400 dark:text-stone-500 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </legend>
    <div class="mb-3">
      <label class="sr-only" for={`${idPrefix}positions-search`}>Search position filters</label>
      <input
        id={`${idPrefix}positions-search`}
        type="search"
        data-filter-search={`${idPrefix}positions-section`}
        placeholder="Search position filters"
        class="w-full rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm text-stone-800 dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-copper"
      />
    </div>
    <div id={`${idPrefix}positions-section`} class="space-y-1.5 max-h-64 overflow-y-auto scrollbar-thin">
      {positions.map((position) => (
        <label class="flex items-center gap-2 cursor-pointer group py-1 min-h-[32px]" data-filter-option data-filter-label={position.name.toLowerCase()}>
          <input
            type="checkbox"
            name="position"
            value={position.name}
            class="filter-checkbox w-4 h-4 rounded border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-700 text-copper focus:ring-2 focus:ring-copper focus:ring-offset-stone-100 dark:focus:ring-offset-stone-800"
          />
          <span class="text-sm text-stone-700 dark:text-stone-300 group-hover:text-copper transition-colors truncate" title={position.name}>
            {position.name}
          </span>
          <span class="ml-auto text-xs text-stone-500 dark:text-stone-400 tabular-nums">
            {position.count}
          </span>
        </label>
      ))}
      <p class="hidden text-sm text-stone-500 dark:text-stone-400 py-2" data-filter-empty>
        No matching position filters.
      </p>
    </div>
  </fieldset>

  {tags.length > 0 && (
    <fieldset class="mb-2">
      <legend class="w-full">
        <button
          class="filter-section-toggle flex items-center justify-between w-full text-left mb-3"
          data-section={`${idPrefix}tags`}
          aria-expanded="true"
          aria-controls={`${idPrefix}tags-section`}
          type="button"
        >
          <span class="text-sm font-semibold text-stone-700 dark:text-stone-200 uppercase tracking-wide">Tags</span>
          <svg class="w-4 h-4 text-stone-400 dark:text-stone-500 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </legend>
      <div class="mb-3">
        <label class="sr-only" for={`${idPrefix}tags-search`}>Search tag filters</label>
        <input
          id={`${idPrefix}tags-search`}
          type="search"
          data-filter-search={`${idPrefix}tags-section`}
          placeholder="Search tags"
          class="w-full rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm text-stone-800 dark:text-stone-100 placeholder:text-stone-400 dark:placeholder:text-stone-500 focus:outline-none focus:ring-2 focus:ring-copper"
        />
      </div>
      <div id={`${idPrefix}tags-section`} class="space-y-1.5 max-h-48 overflow-y-auto scrollbar-thin">
        {tags.map((tag) => (
          <label class="flex items-center gap-2 cursor-pointer group py-1 min-h-[32px]" data-filter-option data-filter-label={tag.name.toLowerCase()}>
            <input
              type="checkbox"
              name="tag"
              value={tag.name}
              class="filter-checkbox w-4 h-4 rounded border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-700 text-copper focus:ring-2 focus:ring-copper focus:ring-offset-stone-100 dark:focus:ring-offset-stone-800"
            />
            <span class="text-sm text-stone-700 dark:text-stone-300 group-hover:text-copper transition-colors truncate" title={tag.name}>
              {tag.name}
            </span>
            <span class="ml-auto text-xs text-stone-500 dark:text-stone-400 tabular-nums">
              {tag.count}
            </span>
          </label>
        ))}
        <p class="hidden text-sm text-stone-500 dark:text-stone-400 py-2" data-filter-empty>
          No matching tags.
        </p>
      </div>
    </fieldset>
  )}
</aside>

<script>
  function bindSectionToggles() {
    document.querySelectorAll<HTMLButtonElement>('.filter-section-toggle').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const section = btn.getAttribute('data-section');
        if (!section) return;
        const sectionDiv = document.getElementById(`${section}-section`);
        const arrow = btn.querySelector('svg');
        if (!sectionDiv) return;
        const isOpen = !sectionDiv.classList.contains('hidden');
        sectionDiv.classList.toggle('hidden');
        arrow?.classList.toggle('rotate-180');
        btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      });
    });
  }

  function bindFacetSearches() {
    document.querySelectorAll<HTMLInputElement>('[data-filter-search]').forEach((input) => {
      if (input.dataset.bound === '1') return;
      input.dataset.bound = '1';

      const targetId = input.dataset.filterSearch;
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target) return;

      const options = Array.from(target.querySelectorAll<HTMLElement>('[data-filter-option]'));
      const emptyState = target.querySelector<HTMLElement>('[data-filter-empty]');

      const update = () => {
        const query = input.value.trim().toLowerCase();
        let visibleCount = 0;

        options.forEach((option) => {
          const label = option.dataset.filterLabel || '';
          const matches = !query || label.includes(query);
          option.classList.toggle('hidden', !matches);
          if (matches) visibleCount += 1;
        });

        emptyState?.classList.toggle('hidden', visibleCount !== 0);
      };

      input.addEventListener('input', update);
      update();
    });
  }

  function initFilterSidebar() {
    bindSectionToggles();
    bindFacetSearches();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilterSidebar);
  } else {
    initFilterSidebar();
  }
</script>
