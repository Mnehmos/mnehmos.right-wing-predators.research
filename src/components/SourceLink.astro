---
import {
  formatSourceDate,
  normalizeSource,
  sourceTypeLabel,
  type EntrySource,
} from '../utils/source-utils';

interface Props {
  source: EntrySource;
  index?: number;
}

const { source, index } = Astro.props;
const normalized = normalizeSource(source);
const headline = normalized.title || normalized.publisher || normalized.displayDomain;
const publishedAt = formatSourceDate(normalized.publishedAt);
const sourceLabel = sourceTypeLabel(normalized.sourceType);
const urlDisplay = normalized.url.length > 96 ? normalized.url.substring(0, 96) + '...' : normalized.url;
---

<a
  href={normalized.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-start gap-3 p-3 rounded-lg bg-stone-100 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700/50 hover:bg-stone-200 dark:hover:bg-stone-700/50 hover:border-copper transition-all no-underline"
>
  {typeof index === 'number' && (
    <span class="flex-shrink-0 w-6 h-6 rounded-full bg-stone-200 dark:bg-stone-700 text-stone-600 dark:text-stone-400 text-xs flex items-center justify-center font-medium">
      {index + 1}
    </span>
  )}

  <div class="flex-1 min-w-0">
    <div class="text-sm font-medium text-copper group-hover:text-copper-light truncate">
      {headline}
    </div>
    <div class="text-xs text-stone-500 dark:text-stone-400 truncate mt-0.5">
      {normalized.displayDomain}
    </div>
    <div class="text-xs text-stone-500 dark:text-stone-400 break-all mt-1">
      {urlDisplay}
    </div>
    <div class="flex flex-wrap gap-2 mt-2">
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium bg-stone-200 dark:bg-stone-700 text-stone-700 dark:text-stone-300">
        {sourceLabel}
      </span>
      {publishedAt && (
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium bg-stone-200 dark:bg-stone-700 text-stone-700 dark:text-stone-300">
          {publishedAt}
        </span>
      )}
      {normalized.primary && (
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium bg-copper/10 dark:bg-copper/20 text-copper border border-copper/30 dark:border-copper/40">
          Primary
        </span>
      )}
      {normalized.archived && (
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-800/50">
          Archived
        </span>
      )}
    </div>
    {normalized.notes && (
      <div class="text-xs text-stone-500 dark:text-stone-400 mt-2 line-clamp-2">
        {normalized.notes}
      </div>
    )}
  </div>

  <svg class="flex-shrink-0 w-4 h-4 text-stone-400 dark:text-stone-500 group-hover:text-copper transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
  </svg>
</a>
