---
import BaseLayout from '../layouts/BaseLayout.astro';
import feed from '../data/agent-findings.json';

const base = import.meta.env.BASE_URL;
const events = feed.events ?? [];
---

<BaseLayout title="Daily Updates" description="Automated daily findings from the database monitoring agents.">
  <section class="max-w-5xl mx-auto">
    <div class="mb-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-copper">Automated monitoring</p>
      <h1 class="text-3xl md:text-4xl font-bold font-display text-stone-800 dark:text-stone-100">Daily Agent Findings</h1>
      <p class="mt-3 text-stone-600 dark:text-stone-400">
        Machine-qualified findings collected from official records and reputable reporting. Allegations remain labeled as allegations.
      </p>
    </div>

    {events.length === 0 ? (
      <div class="rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-100 dark:bg-stone-900/50 p-8 text-center">
        <h2 class="text-lg font-semibold text-stone-800 dark:text-stone-100">No published findings yet</h2>
        <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">The next monitoring run will populate this page when qualifying events are found.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {events.map((event) => (
          <article class="rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-100 dark:bg-stone-900/50 p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-xl font-semibold text-stone-800 dark:text-stone-100">{event.person}</h2>
                <p class="text-sm text-stone-600 dark:text-stone-400">{event.role}{event.jurisdiction ? ` · ${event.jurisdiction}` : ''}</p>
              </div>
              <span class="badge badge-sources">{event.status.replaceAll('_', ' ')}</span>
            </div>
            <p class="mt-4 text-stone-700 dark:text-stone-300 leading-relaxed">{event.summary}</p>
            {event.subject_response && (
              <p class="mt-3 text-sm text-stone-600 dark:text-stone-400"><strong>Response:</strong> {event.subject_response}</p>
            )}
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-stone-500 dark:text-stone-400">
              <span>{event.agent}</span>
              {event.published_at && <span>{event.published_at}</span>}
              <a href={event.source_url} target="_blank" rel="noreferrer" class="text-copper hover:text-copper-light no-underline">View source</a>
            </div>
          </article>
        ))}
      </div>
    )}

    <p class="mt-8 text-sm text-stone-500 dark:text-stone-400">
      <a href={base} class="text-copper hover:text-copper-light no-underline">Return home</a>
    </p>
  </section>
</BaseLayout>
